{% doc %}
  @prompt
    A heading with an animated glowing effect
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glow-heading-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.font_size }}px;
    line-height: 1.15;
    text-align: {{ block.settings.alignment }};
    text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_spread }}px {{ block.settings.glow_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-glow-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_font_size }}px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .ai-glow-heading-{{ ai_gen_id }} {
      animation: ai-glow-pulse-{{ ai_gen_id }} {{ block.settings.pulse_speed }}s ease-in-out infinite alternate;
    }

    @keyframes ai-glow-pulse-{{ ai_gen_id }} {
      from {
        text-shadow: 0 0 {{ block.settings.glow_size }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_spread }}px {{ block.settings.glow_color }};
      }
      to {
        text-shadow: 0 0 {{ block.settings.glow_spread }}px {{ block.settings.glow_color }}, 0 0 {{ block.settings.glow_spread | times: 1.5 }}px {{ block.settings.glow_color }};
      }
    }
  }
{% endstyle %}

<h2 class="ai-glow-heading-{{ ai_gen_id }}" {{ block.shopify_attributes }}>{{ block.settings.heading | escape }}</h2>

{% schema %}
{
  "name": "Glowing heading",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading text",
      "default": "Discover something special"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Font",
      "default": "inter_n7"
    },
    {
      "type": "range",
      "id": "font_size",
      "label": "Desktop text size",
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "mobile_font_size",
      "label": "Mobile text size",
      "min": 16,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#111111"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#BFA36A"
    },
    {
      "type": "range",
      "id": "glow_size",
      "label": "Glow softness",
      "min": 2,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "glow_spread",
      "label": "Glow reach",
      "min": 4,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "pulse_speed",
      "label": "Glow pulse speed",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "s",
      "default": 3
    }
  ],
  "presets": [
    {
      "name": "Glowing heading"
    }
  ],
  "tag": null,
  "class": "glowing-heading-block"
}
{% endschema %}