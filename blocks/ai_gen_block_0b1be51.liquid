{% doc %}
  @prompt
    Create a customizable storefront block with a smooth sliding entrance animation: content slides in from the left as it enters view. Include editable heading, text, optional image, and button, with controls for slide direction and animation speed. Keep the design responsive and respect reduced-motion preferences.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slide-entry-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
  }

  .ai-slide-entry-{{ ai_gen_id }}__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(24px, 5vw, 64px);
    padding: clamp(24px, 5vw, 64px);
    background: {{ block.settings.background_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    overflow: hidden;
  }

  .ai-slide-entry-{{ ai_gen_id }}__copy {
    min-width: 0;
  }

  .ai-slide-entry-{{ ai_gen_id }}__heading {
    margin: 0 0 16px;
    color: {{ block.settings.text_color }};
    font-family: {{ settings.type_heading_font.family }}, {{ settings.type_heading_font.fallback_families }};
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1.08;
  }

  .ai-slide-entry-{{ ai_gen_id }}__text {
    color: {{ block.settings.text_color }};
    font-size: 16px;
    line-height: 1.65;
  }

  .ai-slide-entry-{{ ai_gen_id }}__text p {
    margin: 0 0 16px;
  }

  .ai-slide-entry-{{ ai_gen_id }}__text p:last-child {
    margin-bottom: 0;
  }

  .ai-slide-entry-{{ ai_gen_id }}__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: 24px;
    padding: 13px 25px;
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ settings.button_border_radius_primary }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ settings.type_body_font.family }}, {{ settings.type_body_font.fallback_families }};
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 160ms ease;
  }

  .ai-slide-entry-{{ ai_gen_id }}__button:hover {
    opacity: 0.84;
  }

  .ai-slide-entry-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.text_color }};
    outline-offset: 4px;
  }

  .ai-slide-entry-{{ ai_gen_id }}__media {
    position: relative;
    min-width: 0;
    overflow: hidden;
    border-radius: 4px;
  }

  .ai-slide-entry-{{ ai_gen_id }}__image {
    display: block;
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .ai-slide-entry-{{ ai_gen_id }}__placeholder {
    display: flex;
    aspect-ratio: 4 / 3;
    align-items: center;
    justify-content: center;
    background: #fff2f5;
  }

  .ai-slide-entry-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    max-height: 460px;
    color: #682c46;
  }

  .ai-slide-entry-{{ ai_gen_id }}__empty-state {
    position: absolute;
    right: 12px;
    bottom: 12px;
    left: 12px;
    padding: 8px 10px;
    background: #fff2f5;
    color: #682c46;
    font-size: 13px;
    text-align: center;
  }

  .ai-slide-entry-{{ ai_gen_id }}.is-ready .ai-slide-entry-{{ ai_gen_id }}__panel {
    opacity: 0;
    transition: opacity {{ block.settings.animation_speed }}ms ease, transform {{ block.settings.animation_speed }}ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: opacity, transform;
  }

  .ai-slide-entry-{{ ai_gen_id }}.is-ready[data-direction="left"] .ai-slide-entry-{{ ai_gen_id }}__panel {
    transform: translateX(-48px);
  }

  .ai-slide-entry-{{ ai_gen_id }}.is-ready[data-direction="right"] .ai-slide-entry-{{ ai_gen_id }}__panel {
    transform: translateX(48px);
  }

  .ai-slide-entry-{{ ai_gen_id }}.is-ready[data-direction="up"] .ai-slide-entry-{{ ai_gen_id }}__panel {
    transform: translateY(36px);
  }

  .ai-slide-entry-{{ ai_gen_id }}.is-ready[data-direction="down"] .ai-slide-entry-{{ ai_gen_id }}__panel {
    transform: translateY(-36px);
  }

  .ai-slide-entry-{{ ai_gen_id }}.is-visible .ai-slide-entry-{{ ai_gen_id }}__panel {
    opacity: 1;
    transform: translate(0, 0);
  }

  @media screen and (max-width: 749px) {
    .ai-slide-entry-{{ ai_gen_id }} {
      width: 100%;
    }

    .ai-slide-entry-{{ ai_gen_id }}__panel {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 26px 20px;
    }

    .ai-slide-entry-{{ ai_gen_id }}__heading {
      font-size: clamp(28px, 8vw, 40px);
    }

    .ai-slide-entry-{{ ai_gen_id }}__media {
      grid-row: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-slide-entry-{{ ai_gen_id }}.is-ready .ai-slide-entry-{{ ai_gen_id }}__panel,
    .ai-slide-entry-{{ ai_gen_id }}__button {
      transition: none;
    }

    .ai-slide-entry-{{ ai_gen_id }}.is-ready .ai-slide-entry-{{ ai_gen_id }}__panel {
      opacity: 1;
      transform: none;
      will-change: auto;
    }
  }
{% endstyle %}

<slide-entry-{{ ai_gen_id }}
  class="ai-slide-entry-{{ ai_gen_id }}"
  data-direction="{{ block.settings.slide_direction }}"
  data-speed="{{ block.settings.animation_speed }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-slide-entry-{{ ai_gen_id }}__panel">
    <div class="ai-slide-entry-{{ ai_gen_id }}__copy">
      {% if block.settings.heading != blank %}
        <h2 class="ai-slide-entry-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
      {% endif %}
      {% if block.settings.body_text != blank %}
        <div class="ai-slide-entry-{{ ai_gen_id }}__text">{{ block.settings.body_text }}</div>
      {% endif %}
      {% if block.settings.button_label != blank and block.settings.button_link != blank %}
        <a class="ai-slide-entry-{{ ai_gen_id }}__button" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
      {% endif %}
    </div>
    <div class="ai-slide-entry-{{ ai_gen_id }}__media">
      {% if block.settings.image != blank %}
        <img
          class="ai-slide-entry-{{ ai_gen_id }}__image"
          src="{{ block.settings.image | image_url: width: 1200 }}"
          alt="{{ block.settings.image.alt | escape }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="ai-slide-entry-{{ ai_gen_id }}__placeholder">
          {{ 'image' | placeholder_svg_tag }}
          <span class="ai-slide-entry-{{ ai_gen_id }}__empty-state">Add an image in the block settings, or leave this area as a visual placeholder.</span>
        </div>
      {% endif %}
    </div>
  </div>
</slide-entry-{{ ai_gen_id }}>

<script>
  (() => {
    const tagName = 'slide-entry-{{ ai_gen_id }}';
    if (customElements.get(tagName)) return;

    class SlideEntry extends HTMLElement {
      connectedCallback() {
        if (this.initialized) return;
        this.initialized = true;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
          this.classList.add('is-visible');
          return;
        }

        this.classList.add('is-ready');
        this.observer = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              this.classList.add('is-visible');
              this.observer.disconnect();
            }
          });
        }, { threshold: 0.15 });
        this.observer.observe(this);
      }

      disconnectedCallback() {
        if (this.observer) this.observer.disconnect();
      }
    }

    customElements.define(tagName, SlideEntry);
  })();
</script>

{% schema %}
{
  "name": "Slide-in content",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for your everyday"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Text",
      "default": "<p>Discover thoughtful pieces designed to bring a little more character to your day.</p>"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "select",
      "id": "slide_direction",
      "label": "Slide direction",
      "options": [
        { "value": "left", "label": "From left" },
        { "value": "right", "label": "From right" },
        { "value": "up", "label": "From bottom" },
        { "value": "down", "label": "From top" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "label": "Animation speed",
      "min": 300,
      "max": 1200,
      "step": 100,
      "unit": "ms",
      "default": 700
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F8E5EB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#682C46"
    },
    {
      "type": "color",
      "id": "button_color",
      "label": "Button background",
      "default": "#682C46"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text",
      "default": "#FFF2F5"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 8
    }
  ],
  "presets": [
    {
      "name": "Slide-in content"
    }
  ],
  "tag": null,
  "class": "slide-in-content-block"
}
{% endschema %}