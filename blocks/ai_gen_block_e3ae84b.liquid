{% doc %}
  @prompt
    Create a green WhatsApp chat icon button fixed at the bottom-right of the storefront, mobile-friendly and not overlapping the cart or other controls. Let me set my WhatsApp phone number including country code and an optional prefilled message. Clicking the icon should open a WhatsApp chat using a wa.me link. Include an accessible 'Chat with us on WhatsApp' label.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-whatsapp-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-whatsapp-{{ ai_gen_id }}__link {
    position: fixed;
    z-index: 40;
    right: max(20px, env(safe-area-inset-right));
    bottom: max(20px, env(safe-area-inset-bottom));
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #075e3b;
    color: #ffffff;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.25);
    text-decoration: none;
  }

  .ai-whatsapp-{{ ai_gen_id }}__link:hover {
    background: #064b30;
  }

  .ai-whatsapp-{{ ai_gen_id }}__link:focus-visible {
    outline: 3px solid #111111;
    outline-offset: 3px;
  }

  .ai-whatsapp-{{ ai_gen_id }}__link svg {
    width: 32px;
    height: 32px;
    fill: currentColor;
  }

  .ai-whatsapp-{{ ai_gen_id }}__label {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (max-width: 749px) {
    .ai-whatsapp-{{ ai_gen_id }}__link {
      right: max(16px, env(safe-area-inset-right));
      bottom: max(84px, calc(env(safe-area-inset-bottom) + 84px));
      width: 56px;
      height: 56px;
    }
  }
{% endstyle %}

{% assign whatsapp_phone = block.settings.phone_number | remove: ' ' | remove: '+' | remove: '-' | remove: '(' | remove: ')' %}
{% if whatsapp_phone != blank %}
  {% capture whatsapp_url %}https://wa.me/{{ whatsapp_phone }}{% if block.settings.prefilled_message != blank %}?text={{ block.settings.prefilled_message | url_encode }}{% endif %}{% endcapture %}
  <div class="ai-whatsapp-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <a class="ai-whatsapp-{{ ai_gen_id }}__link" href="{{ whatsapp_url | strip }}" target="_blank" rel="noopener noreferrer" aria-label="Chat with us on WhatsApp">
      <span class="ai-whatsapp-{{ ai_gen_id }}__label">Chat with us on WhatsApp</span>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
        <path d="M16.02 3a12.9 12.9 0 0 0-11.1 19.47L3.2 29l6.69-1.75A12.9 12.9 0 1 0 16.02 3Zm0 23.55c-1.91 0-3.78-.51-5.41-1.49l-.39-.23-3.97 1.04 1.06-3.87-.25-.4a10.62 10.62 0 1 1 8.96 4.95Zm5.83-7.95c-.32-.16-1.88-.93-2.17-1.03-.29-.11-.5-.16-.71.16-.21.32-.82 1.03-1 1.24-.19.21-.37.24-.69.08-.32-.16-1.35-.5-2.57-1.59-.95-.85-1.59-1.9-1.78-2.22-.18-.32-.02-.5.14-.66.14-.14.32-.37.48-.55.16-.19.21-.32.32-.53.1-.21.05-.4-.03-.56-.08-.16-.71-1.72-.98-2.35-.26-.62-.52-.54-.71-.55h-.61c-.21 0-.55.08-.84.4-.29.32-1.1 1.08-1.1 2.64s1.13 3.06 1.29 3.27c.16.21 2.22 3.39 5.38 4.75.75.32 1.34.51 1.8.65.76.24 1.45.2 1.99.12.61-.09 1.88-.77 2.14-1.51.27-.74.27-1.37.19-1.51-.08-.13-.29-.21-.61-.37Z"/>
      </svg>
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "WhatsApp chat button",
  "settings": [
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone number with country code",
      "default": "923001234567"
    },
    {
      "type": "text",
      "id": "prefilled_message",
      "label": "Prefilled message"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "WhatsApp chat button"
    }
  ],
  "tag": null,
  "class": "whatsapp-chat-block"
}
{% endschema %}